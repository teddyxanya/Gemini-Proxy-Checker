# =====================================================================
# Gemini Proxy Checker & Subscription Daemon Configuration
# =====================================================================

# Ссылка на исходную подписку прокси (VLESS, VMess, Trojan, Shadowsocks, Hysteria 2)
SUB_URL="https://your-provider.example.com/sub/YOUR_KEY"

# Ключ Google Gemini API для верификации генерации контента
GEMINI_API_KEY="AIzaSy...Ваш_Ключ...API"

# Настройки Git для авто-пуша обновленного shadowrocket.conf
GIT_REPO_URL="git@github.com:YOUR_USERNAME/Gemini-Proxy-Checker.git"
GIT_BRANCH="main"

# Локальный путь для сохранения конфигурации Shadowrocket
CONF_PATH="/opt/gemini-proxy-checker/shadowrocket.conf"

# Настройки для e0f_sub_server.py (сервер подписок и AWG)
EOF_TOKEN="eyJhbGciOi...Ваш_Токен_Авторизации_EOF...XYZ"
SECRET_TOKEN="default_subscription_secret_key"
PORT=8088
VPS_IP="127.0.0.1"

# Telegram бот для оповещений об изменении статуса нод
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_CHAT_ID="12345678"

# Telegram user_id владельца (защита административных команд)
TELEGRAM_OWNER_ID="12345678"
