# Ссылка на вашу исходную подписку (откуда брать серверы для проверки)
SUB_URL="https://xo.example.com/sub/YOUR_SUB_KEY"

# Ключ Gemini API для проверки работоспособности генерации
GEMINI_API_KEY="AIzaSy...Ваш_Ключ...API"

# Настройки Git для авто-пуша обновленного shadowrocket.conf
GIT_REPO_URL="git@github.com:YOUR_USERNAME/YOUR_REPO.git"
GIT_BRANCH="main"

# Путь для сохранения локального конфига Shadowrocket
CONF_PATH="/opt/gemini-proxy-checker/shadowrocket.conf"

# Настройки для e0f_sub_server.py (сервер подписок)
EOF_TOKEN="eyJhbGciOi...Ваш_Токен_Авторизации_EOF...XYZ"
SECRET_TOKEN="default_subscription_secret_key"
PORT=8088

# Telegram бот для получения уведомлений об отвале серверов и слотах
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_CHAT_ID="12345678"

# Ваш Telegram user_id (найти можно через @userinfobot). Защищает команду /check.
TELEGRAM_OWNER_ID="12345678"
VPS_IP=" YOUR_VPS_IP\
